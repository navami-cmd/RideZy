# Copy this file to ".env" and fill in what you need. Every value is optional.

PORT=3000
NODE_ENV=development

# Payments: Razorpay. Start with TEST keys.
# Razorpay Dashboard > switch on "Test Mode" > Account & Settings > API Keys > Generate Key
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Real SMS codes: Twilio. Leave empty and the code is printed in the server console instead.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Dispatch: how far (km) from the pickup to look for drivers
DISPATCH_RADIUS_KM=10

# Set to true so new drivers must be approved (set "approved": true in data/db.json) before going online
REQUIRE_DRIVER_APPROVAL=false

# Only needed if the website and the server are on different domains in production
ALLOWED_ORIGIN=

# Demo drivers: simulated drivers that appear near any pickup so rides always find a driver while you test.
# Real drivers (signed in at /driver.html) always get requests first. Defaults to true on your own computer
# and false when NODE_ENV=production. Turn it off before you take real passengers.
DEMO_DRIVERS=true
